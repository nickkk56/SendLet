{
  "name": "sendlet",
  "version": "0.1.0",
  "description": "Lightweight self-hosted mailing list tool for collecting subscribers and sending broadcast emails",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outdir=dist --packages=external --jsx-import-source=hono/jsx --jsx=automatic"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.8.0",
    "nodemailer": "^10.0.10",
    "resend": "^6.0.0",
    "tsx": "^4.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0"
  },
  "license": "MIT"

}

