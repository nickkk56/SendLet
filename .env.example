# Email provider: resend, smtp
EMAIL_PROVIDER=smtp

# SMTP settings (required when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password-or-app-password
SMTP_SECURE=false

# Resend API key (required when EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_your_api_key_here

# Sender email address for broadcasts
EMAIL_FROM=noreply@yourdomain.com

# Base URL of the service (used to build confirm/unsubscribe links in emails)
BASE_URL=http://localhost:3000

# Password for dashboard access
DASHBOARD_PASSWORD=change-me

# Path to the SQLite database file
DATABASE_PATH=./data/subscribers.db

# Port the server listens on
PORT=3000
